{
  // Per-repo configuration for TimeWarp.Terminal dev-cli
  "checkVersionConfig": {
    "checkVersionStrategy": "nuget-search"
  },
  // Additions to PullRequestBuildClassifier (dev workflow on a pull request).
  // samples/** is a build root: dev workflow verifies every sample, so sample
  // markdown changes still build. readme.md and assets/logo.png are packed into
  // the nupkgs, so a pull request that touches only them must still build. The
  // defaults would skip them (root markdown and assets/**).
  "pullRequestBuild": {
    "buildPaths": [
      "samples/**",
      "readme.md",
      "assets/logo.png"
    ]
  }
}
