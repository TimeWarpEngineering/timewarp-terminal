<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup Label="MsBuild Packaging Defaults">
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- Pack only Release builds. Samples, tests, and file-based programs reference
       these projects and build them in Debug. With GeneratePackageOnBuild
       unconditional, any Debug build repacked a Debug nupkg over the Release one
       in artifacts/packages, and CI uploaded that artifact (timewarp-nuru task 503). -->
  <PropertyGroup Label="Release-only packing">
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Default package metadata (can be overridden in individual projects) -->
  <PropertyGroup Label="Package Metadata">
    <Version>2.0.0-beta.1</Version>
    <Authors>Steven T. Cramer</Authors>
    <RepositoryUrl>https://github.com/TimeWarpEngineering/timewarp-terminal</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/TimeWarpEngineering/timewarp-terminal</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/TimeWarpEngineering/timewarp-terminal/releases</PackageReleaseNotes>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageIcon>logo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Label="Shared Package Assets">
    <None Include="$(RepositoryRoot)assets/logo.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
