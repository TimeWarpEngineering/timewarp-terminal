<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>TimeWarp.Terminal</AssemblyName>
    <RootNamespace>TimeWarp.Terminal</RootNamespace>
    <Description>Framework-agnostic, testable console and output layer for any .NET CLI or console app. IConsole, ITerminal, TestTerminal, panels, tables, rules, OSC 8 hyperlinks, and ANSI color. No CLI framework required.</Description>
    <PackageTags>terminal;console;ansi;colors;widgets;panel;table;cli;testing;aot;timewarp</PackageTags>

    <!-- Package settings -->
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- AOT Compatibility -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TimeWarp.Builder" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../readme.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
