<Project>
  <!-- Import parent Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- The dev CLI is not a shipped package. Parent GeneratePackageOnBuild must not pack it. -->
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>

    <!-- Suppress warnings that don't apply to CLI tools -->
    <!-- CA1031: Catch general exception types - OK for CLI error handling -->
    <!-- CA1034: Nested types - used by Nuru command pattern -->
    <!-- CA1303: Literal strings - OK for CLI output -->
    <!-- CA1508: Dead code analysis false positive -->
    <!-- CA1515: Internal types in exe projects are fine -->
    <!-- CA1849: Sync WriteLine is fine for CLI output - ITerminal doesn't have async methods -->
    <!-- CA2007: ConfigureAwait not needed in top-level console apps -->
    <!-- CA2016: CancellationToken forwarding - will address where needed -->
    <!-- CA2000: Dispose on app builder - handled by framework -->
    <!-- RCS1046: Async suffix - private methods don't need it -->
    <!-- IDE0005: requires GenerateDocumentationFile, which is off for AOT runfile publish -->
    <!-- IDE0211: dev.cs is a file-based app (runfile) and requires top-level statements -->
    <!-- IL2026, IL3050: reflection-based JsonSerializer in TimeWarp.Nuru.DevCli content
         files; suppressed here only — the library itself builds clean under full
         trim/AOT analysis -->
    <NoWarn>$(NoWarn);CA1031;CA1034;CA1303;CA1508;CA1515;CA1849;CA2007;CA2016;CA2000;RCS1046;CA5399;IL2026;IL2104;IL3050;IL3053;IDE0005;IDE0211</NoWarn>

    <!-- The dev CLI is a runfile, not a product assembly. With XML docs on, the AOT publish
         (worktree onCreate self-install) fails MSB3030 looking for bin/release/dev.xml.
         Matches timewarp-flow and timewarp-architecture a98eddc34. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- AOT Support -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    
    <!-- Enable interceptors for Nuru source generator -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);TimeWarp.Nuru.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <!-- Global usings for dev-cli -->
    <Using Include="System" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Diagnostics" />
    <Using Include="System.Runtime.CompilerServices" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Xml.Linq" />

    <Using Include="TimeWarp.Nuru" />
    <Using Include="TimeWarp.Mediator" />
    <Using Include="TimeWarp.Amuru" />
    <Using Include="TimeWarp.Terminal" />
    <Using Include="DevCli" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />

    <Using Include="System.Console" Static="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include endpoint files in compilation -->
    <Compile Include="endpoints/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Project references -->
    <ProjectReference Include="../../source/timewarp-terminal/timewarp-terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Package references -->
    <PackageReference Include="TimeWarp.Amuru" />
    <PackageReference Include="TimeWarp.Amuru.Tools" />
    <PackageReference Include="TimeWarp.Nuru" />
    <PackageReference Include="TimeWarp.Nuru.DevCli" />
  </ItemGroup>

  <!-- TimeWarp.Nuru.DevCli ships C# content files compiled from $(NuGetPackageRoot),
       where the repo .editorconfig cannot reach and two upstream files exceed 500 lines
       (TWA0038). Exempt only Compile items under $(NuGetPackageRoot) so all analyzers
       stay active on this repo's own tools/dev-cli sources (matches timewarp-architecture
       task 470). -->
  <Target Name="ExemptPackageContentFromAnalyzers"
          BeforeTargets="CoreCompile"
          Condition="'$(NuGetPackageRoot)' != ''">
    <PropertyGroup>
      <_TwPackageContentConfig>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'package-content-analyzers.globalconfig'))</_TwPackageContentConfig>
      <_TwNuGetPackageRoot>$([System.String]::Copy('$(NuGetPackageRoot)').Replace('\','/'))</_TwNuGetPackageRoot>
    </PropertyGroup>
    <ItemGroup>
      <_TwPackageContentCompile Include="@(Compile->'%(FullPath)'->Replace('\','/'))" />
      <_TwPackageContentCompile Remove="@(_TwPackageContentCompile)"
                                Condition="!$([System.String]::Copy('%(Identity)').StartsWith('$(_TwNuGetPackageRoot)'))" />
      <_TwPackageContentLine Include="is_global = true" />
      <_TwPackageContentLine Include="@(_TwPackageContentCompile->'[%(Identity)]%0Adotnet_analyzer_diagnostic.severity = none')" />
    </ItemGroup>
    <WriteLinesToFile File="$(_TwPackageContentConfig)"
                      Lines="@(_TwPackageContentLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EditorConfigFiles Include="$(_TwPackageContentConfig)" />
      <FileWrites Include="$(_TwPackageContentConfig)" />
    </ItemGroup>
  </Target>

</Project>
