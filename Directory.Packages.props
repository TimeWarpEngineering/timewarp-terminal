<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- MSBuild and NuGet behavior configuration -->
  <PropertyGroup Label="MSBuild/NuGet Configuration">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="TimeWarp Packages">
    <!-- The nuru audit fix raises direct TimeWarp companion pins to the latest
         feed version, and Amuru 3.0.0-beta.2 / Tools 3.0.0-beta.2 ship net11.0
         only. The product targets net11.0, so that pin restores. dev-cli's
         project reference to timewarp-terminal satisfies Amuru's
         TimeWarp.Terminal dependency. -->
    <PackageVersion Include="TimeWarp.Amuru" Version="3.0.0-beta.2" />
    <PackageVersion Include="TimeWarp.Amuru.Tools" Version="3.0.0-beta.2" />
    <PackageVersion Include="TimeWarp.Builder" Version="2.1.0-beta.1" />
    <PackageVersion Include="TimeWarp.Flexbox" Version="2.0.0-beta.3" />
    <!-- Jaribu beta.12 pulled Amuru beta.21 -> StreamJsonRpc -> MessagePack 2.5.198
         (NU1902/NU1903 under TreatWarningsAsErrors). beta.15 restores clean. -->
    <PackageVersion Include="TimeWarp.Jaribu" Version="1.0.0-beta.16" />
    <PackageVersion Include="TimeWarp.Nuru" Version="4.0.0-beta.13" />
    <PackageVersion Include="TimeWarp.Nuru.DevCli" Version="4.0.0-beta.13" />
    <PackageVersion Include="TimeWarp.Build.Tasks" Version="2.0.1-beta.1" />
    <PackageVersion Include="TimeWarp.SourceGenerators" Version="1.0.0-beta.16" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup Label="Code Analyzers">
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.CodeAnalysis.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Roslynator.Formatting.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="11.0.100" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.CodeStyle" Version="5.12.0" />
  </ItemGroup>
</Project>
